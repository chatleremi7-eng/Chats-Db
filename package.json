{
  "name": "chat-backend",
  "version": "1.0.0",
  "description": "Production-ready Realtime Chat Backend API with Express, Socket.IO, JWT, and SQLite",
  "main": "src/server.js",
  "scripts": {
    "start": "node /src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "node /src/config/run-migrations.js",
    "test": "jest --detectOpenHandles --forceExit"
  },
  "dependencies": {
    "approve": "^0.0.12",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.23.1",
    "pkg": "^5.8.1",
    "scripts": "^0.1.0",
    "socket.io": "^4.7.5",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "allowScripts": {
    "pkg@5.8.1": true
  }
}
